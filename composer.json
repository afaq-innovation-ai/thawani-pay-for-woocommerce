{
    "name": "afaq-innovation-ai/thawani-pay-for-woocommerce",
    "description": "Thawani Checkout payment gateway for WooCommerce — hosted checkout, saved cards, refunds, webhooks and reconciliation.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Afaq Innovation and AI"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "AfaqInnovation\\ThawaniPay\\": "src/",
            "AfaqInnovation\\ThawaniPay\\Tests\\": "tests/unit/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "7.4.33"
        }
    }
}
