#. Plugin Name of the plugin
#: thawani-pay-for-woocommerce.php
msgid "Thawani Pay for WooCommerce"
msgstr "ثواني للدفع لـ WooCommerce"

#. Description of the plugin
#: thawani-pay-for-woocommerce.php
msgid "Accept debit and credit card payments in Omani Rial through Thawani Checkout — hosted checkout, saved cards, subscriptions, one-click refunds, signed webhooks and automatic payment reconciliation."
msgstr "اقبل مدفوعات البطاقات البنكية والائتمانية بالريال العماني عبر بوابة ثواني: صفحة دفع مستضافة، وبطاقات محفوظة، واشتراكات، واسترداد بنقرة واحدة، وإشعارات Webhook موقعة، ومطابقة تلقائية للمدفوعات."

#. Author of the plugin
#: thawani-pay-for-woocommerce.php
msgid "Afaq Innovation and AI"
msgstr "آفاق الابتكار والذكاء الاصطناعي"

